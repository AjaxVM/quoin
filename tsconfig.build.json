{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // No ambient node/jest globals: src/ ships to run unmodified in a browser
    // (see examples/no-build.html), so this build must fail if it ever leaks one.
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
